# Copy to .env. Defaults below match the local Supabase stack (`supabase start`).
# For production, set the same variables in Vercel → Project → Settings → Environment Variables.

# --- Backend (never exposed to the browser) ---
# Postgres URL. Hosted: Supabase "Transaction pooler" URL (port 6543), with the postgresql+psycopg:// scheme.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
# Supabase project URL (used to fetch JWT signing keys).
SUPABASE_URL=http://127.0.0.1:54321
# Legacy HS256 JWT secret. Leave empty if your project only uses signing keys (hosted: Project Settings → JWT Keys).
# Local stack only: `supabase status` shows it (super-secret-jwt-token-with-at-least-32-characters-long).
# Never use that public default in production: outside localhost it, or any secret under 32 bytes, is refused.
SUPABASE_JWT_SECRET=
# Service role key: only used by scripts/create_owner.py. Get it from `supabase status` or the dashboard.
SUPABASE_SERVICE_ROLE_KEY=
# The only account allowed to use the app.
OWNER_EMAIL=you@example.com
# Optional: that account's user id (Supabase → Authentication → Users, a uuid). When set, a token must carry it too.
OWNER_ID=
# Shared secret for the Mac sync script. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SYNC_TOKEN=change-me
# Optional: the iPhone watch app's token; it can only read the coming runs and swims (GET /api/watch/runs).
# At least 16 characters, or it never works. Generate it the same way as SYNC_TOKEN; leave empty to turn it off.
WATCH_TOKEN=

# --- AI coach ---
# From console.anthropic.com → API keys. Server-side only; without it the Coach page shows a setup message.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Daily coach spend cap in US dollars (estimated from token usage, Brussels days). Past it the coach waits for tomorrow.
COACH_DAILY_BUDGET_USD=5

# --- Frontend (safe to expose) ---
VITE_SUPABASE_URL=http://127.0.0.1:54321
# The anon / publishable key from `supabase status` or the dashboard.
VITE_SUPABASE_ANON_KEY=
