{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["lhr1"],
  "services": {
    "api": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "lockedin.app:app",
      "functions": {
        "lockedin/app.py": {
          "maxDuration": 300,
          "excludeFiles": "{web/**,tests/**,samples/**,supabase/**,sync/**,ios/**,docs/**,scripts/**,.venv/**,**/node_modules/**}"
        }
      }
    },
    "web": {
      "root": "web",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
