PY := .venv/bin/python

UV_VERSION := 0.13.6

.PHONY: install dev test samples owner db-up lock

install:
	python3 -m venv .venv
	$(PY) -m pip install -q --upgrade pip
	$(PY) -m pip install -q -e '.[dev]'
	npm --prefix web install

db-up:
	supabase status >/dev/null 2>&1 || supabase start -x realtime,storage-api,imgproxy,edge-runtime,logflare,vector,supavisor

dev:
	./scripts/dev.sh

test: db-up
	$(PY) -m pytest

samples:
	$(PY) scripts/make_samples.py

owner:
	@test -n "$(EMAIL)" || (echo "usage: make owner EMAIL=you@example.com (asks for the password)" && exit 1)
	$(PY) scripts/create_owner.py --email "$(EMAIL)"

# Re-pin uv.lock (what Vercel installs) and requirements.txt after editing pyproject.toml.
# Keeps current versions where they still fit; `make lock UPGRADE=--upgrade` moves everything to the newest allowed.
lock:
	@set -e; d=$$(mktemp -d); trap 'rm -rf "$$d"' EXIT; \
	python3 -m venv "$$d" && "$$d/bin/pip" install -q "uv==$(UV_VERSION)"; \
	"$$d/bin/uv" lock $(UPGRADE); \
	{ echo "# Generated by \`make lock\` from uv.lock: every runtime dependency, pinned. Don't edit by hand;"; \
	  echo "# change pyproject.toml and rerun \`make lock\`. Vercel installs from uv.lock, this file mirrors it for pip."; \
	  "$$d/bin/uv" export --frozen --no-dev --no-hashes --no-emit-project --no-header --no-annotate; } > requirements.txt
